global-exclude *.pcd
global-exclude *.pth
global-exclude *.pt
global-exclude *.ckpt
global-exclude *.onnx
global-exclude *.jpg
global-exclude *.jpeg
global-exclude *.png
global-exclude *.mp4
global-exclude scm_version.json
