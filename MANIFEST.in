include README.md
include LICENSE
include CHANGELOG.md
include MIGRATING-3.0-TO-3.1.md
include pyproject.toml
include setup.py
include scripts/run_geometry_conformance.py
include scripts/verify_geometry_fixture_integrity.py
include docs/release-3.6.0-checklist.md

recursive-include panorai *.py
include panorai/py.typed
include panorai/geometry/geometry-v1.yaml

global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.ipynb
global-exclude .DS_Store
global-exclude *.npz
global-exclude *.pcd
global-exclude *.pth
global-exclude *.pt
global-exclude *.ckpt
global-exclude *.onnx
global-exclude *.jpg
global-exclude *.jpeg
global-exclude *.png
global-exclude *.mp4
global-exclude scm_version.json
include docs/_static/tutorials/feature-detectors.jpg
include docs/_static/tutorials/feature-matches.jpg
include docs/_static/tutorials/nature-reserve-forest-erp.jpg
include docs/_static/tutorials/poly-haven-studio-erp.jpg
include docs/_static/tutorials/spherical-stereo-synthetic.png
include docs/_static/tutorials/*.svg
include docs/_static/tutorials/spherical-histogram-equalization.jpg
include docs/_static/tutorials/spherical-dog-sift.jpg
include docs/_static/tutorials/spherical-cam-imagenet-lakeside.jpg
include docs/_static/tutorials/spherical-cam-imagenet-studio-desk.jpg
include docs/_static/tutorials/spherical-cam-places365-forest.jpg
include docs/_static/tutorials/spherical-cam-places365-studio-lobby.jpg
include docs/_static/tutorials/spherical-cam-openclip-path.jpg
include docs/_static/tutorials/spherical-cam-openclip-studio-desk.jpg
include docs/_static/tutorials/spherical-image-processing.jpg

prune .github
prune .pytest_cache
prune datasets
prune notebooks
prune tests
