{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "panorai-panorama-stitching/robust-rotation-v2-experimental",
  "profile_id": "panorai-panorama-stitching/robust-rotation-v2-experimental",
  "status": "experimental-development-profile",
  "created_at": "2026-10-20",
  "model": {
    "camera": "central pinhole",
    "motion": "SO(3) rotation about one optical centre",
    "projection": "partial ERP",
    "rejected": [
      "translation or material parallax",
      "rolling shutter",
      "unrectified lens distortion",
      "disconnected registration graph",
      "insufficient feature density",
      "unobservable shared focal length"
    ]
  },
  "primary": {
    "feature_method": "sift",
    "max_features": 4000,
    "ratio_test": 0.75,
    "min_pair_matches": 20,
    "min_pair_inliers": 12,
    "max_transfer_error_px": 3.0,
    "max_angular_error_deg": 1.0,
    "max_median_angular_error_deg": 0.35,
    "min_spatial_coverage": 0.02
  },
  "selective_recovery": {
    "ratio_test": 0.85,
    "min_pair_matches": 8,
    "min_pair_inliers": 8,
    "min_feature_density": 0.0005,
    "feature_density_count_cap": 128,
    "semantics": "Only pairs below the primary descriptor count are reconsidered. Every recovery pair still passes deterministic homography and calibrated central-rotation gates. Feature density is evaluated per source pixel lattice before recovery."
  },
  "development_evidence": {
    "analytic_yaw_deg": [-32.0, 0.0, 32.0],
    "external_manifest": "contracts/panorama-stitching-huginsample-v1.json",
    "external_role": "development replay only; not prospective promotion evidence",
    "required_regressions": [
      "four Durlach triplets connected",
      "two frozen low-texture sky triplets rejected",
      "translated planar capture rejected",
      "deterministic replay",
      "reviewed-v1 configuration and failure record unchanged"
    ]
  },
  "promotion_boundary": {
    "stable": false,
    "new_profile_identity_required": true,
    "new_scene-disjoint_prospective_corpus_required": true,
    "independent_review_required_for_stable": true,
    "installed_artifact_matrix_required": true,
    "threshold_changes_after_future_holdout_is_opened": "forbidden"
  }
}
