{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "panorai-spherical-application-promotion/v1",
  "frozen_at": "2026-10-15",
  "policy": {
    "threshold_changes_after_heldout": "forbidden",
    "development_records_can_satisfy_heldout_requirements": false,
    "missing_measurements": "fail",
    "non_finite_measurements": "fail",
    "source_checkout_only": "insufficient",
    "deterministic_model_stubs": "interface-evidence-only"
  },
  "requirements": [
    {
      "application": "slic",
      "id": "slic-analytic-contract",
      "selector": {"evaluation": "analytic"},
      "minimum_records": 1,
      "checks": [
        {"metric": "solid_angle_4pi", "operator": "true"},
        {"metric": "connected_labels", "operator": "true"},
        {"metric": "deterministic", "operator": "true"},
        {"metric": "periodic_seam", "operator": "true"},
        {"metric": "analytic_cardinalities_and_masks", "operator": "true"},
        {"metric": "controlled_rotation_stability", "operator": "true"},
        {"metric": "planar_low_distortion_limit", "operator": "true"}
      ]
    },
    {
      "application": "dog",
      "id": "dog-analytic-blobs",
      "selector": {"evaluation": "analytic"},
      "minimum_records": 1,
      "checks": [
        {"metric": "isolated_blob_detection_rate", "operator": "ge", "threshold": 1.0},
        {
          "metric": "maximum_angular_error_deg",
          "operator": "le_metric",
          "threshold_metric": "lattice_half_step_deg"
        },
        {"metric": "maximum_scale_level_error", "operator": "le", "threshold": 1.0},
        {"metric": "seam_and_high_latitude_corpus", "operator": "true"}
      ]
    },
    {
      "application": "dog",
      "id": "dog-external-heldout-corpora",
      "selector": {"evaluation": "external", "split": "heldout"},
      "minimum_records": 2,
      "minimum_distinct": {"field": "corpus", "count": 2},
      "checks": [
        {"metric": "repeatability", "operator": "ge", "threshold": 0.60},
        {"metric": "median_location_error_deg", "operator": "le", "threshold": 1.0},
        {"metric": "verified_inlier_precision", "operator": "ge", "threshold": 0.80}
      ]
    },
    {
      "application": "stereo",
      "id": "stereo-analytic-sphere",
      "selector": {"evaluation": "analytic", "corpus": "textured-sphere"},
      "minimum_records": 1,
      "checks": [
        {"metric": "abs_rel", "operator": "le", "threshold": 0.02},
        {"metric": "delta1", "operator": "ge", "threshold": 0.98},
        {"metric": "coverage", "operator": "ge", "threshold": 0.90}
      ]
    },
    {
      "application": "stereo",
      "id": "stereo-external-heldout-corpora",
      "selector": {"evaluation": "external", "split": "heldout"},
      "minimum_records": 2,
      "minimum_distinct": {"field": "corpus", "count": 2},
      "required_values": {
        "corpus": ["Matterport3D", "Stanford2D3D"]
      },
      "checks": [
        {"metric": "median_abs_rel", "operator": "le", "threshold": 0.20},
        {"metric": "median_delta1", "operator": "ge", "threshold": 0.80},
        {"metric": "accepted_coverage", "operator": "ge", "threshold": 0.25},
        {"metric": "confidence_error_monotonic", "operator": "true"},
        {
          "metric": "top_confidence_quartile_error_reduction",
          "operator": "ge",
          "threshold": 0.20
        },
        {"metric": "degenerations_diagnosed_or_abstained", "operator": "true"}
      ]
    },
    {
      "application": "mask-rcnn-paper",
      "id": "mask-rcnn-paper-external-heldout",
      "selector": {"evaluation": "external", "split": "heldout"},
      "minimum_records": 1,
      "checks": [
        {"metric": "real_cam_checkpoint", "operator": "true"},
        {"metric": "real_sam_checkpoint", "operator": "true"},
        {"metric": "proposal_recall_spherical_iou_0_5", "operator": "ge", "threshold": 0.70},
        {"metric": "median_fused_mask_spherical_iou", "operator": "ge", "threshold": 0.50},
        {"metric": "non_abstained_instance_precision", "operator": "ge", "threshold": 0.80},
        {"metric": "non_abstained_instance_coverage", "operator": "ge", "threshold": 0.25},
        {"metric": "no_valid_pixels_outside_support", "operator": "true"},
        {"metric": "thresholds_frozen_on_development_only", "operator": "true"},
        {"metric": "weights_datasets_outputs_external", "operator": "true"}
      ]
    }
  ]
}
