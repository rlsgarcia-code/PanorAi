{
  "$schema": "./public-api-surfaces-v2.schema.json",
  "contract_id": "panorai-public-api-surfaces/v2",
  "release": "3.7.0",
  "series": "3.x",
  "tiers": [
    "stable",
    "compatibility",
    "experimental",
    "internal"
  ],
  "policy": {
    "stable_removal_before": "4.0",
    "experimental_is_compatibility_promise": false,
    "native_backend_is_public_contract": false,
    "promotion_requires_installed_artifact_evidence": true
  },
  "families": [
    {
      "id": "foundations",
      "title": "Stable foundations",
      "summary": "Geometry, multimodal workflow, fusion, and compatibility surfaces."
    },
    {
      "id": "visual-evidence",
      "title": "Spherical visual evidence",
      "summary": "Image processing, features, descriptors, and learned visual frontends."
    },
    {
      "id": "pose-geometry",
      "title": "Pose and relational geometry",
      "summary": "Pairwise pose, probability, and reusable correspondence evidence."
    },
    {
      "id": "mapping-depth",
      "title": "Mapping and depth",
      "summary": "Depth, stereo, reconstruction, bundle adjustment, and SLAM."
    },
    {
      "id": "semantic-evidence",
      "title": "Semantic evidence and localization",
      "summary": "Semantic frontends and feature-indexed region observations."
    },
    {
      "id": "spatial-semantic-graph",
      "title": "Spatial-semantic graph",
      "summary": "Association, spatial posterior, entity lifecycle, persistence, and query."
    },
    {
      "id": "internal",
      "title": "Implementation internals",
      "summary": "Private implementation modules without import compatibility."
    }
  ],
